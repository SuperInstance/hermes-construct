# Hermes Construct — Environment Configuration
#
# Copy this file to .env and fill in your values.
# API keys are loaded by main.rs and NEVER exposed to agent logic.

# ── API Keys ──────────────────────────────────────────────
# These are wrapped in Provider structs. The ensign only sees the Provider trait.

# DeepInfra API key (https://deepinfra.com)
# Enables: seed-2.0-mini, Llama, Qwen, and other open models
DEEPINFRA_API_KEY=sk-your-deepinfra-key-here

# z.ai API key (https://z.ai)
# Enables: GLM-4-flash and other z.ai models
ZAI_API_KEY=your-zai-key-here

# ── Telegram ──────────────────────────────────────────────
# Bot token from @BotFather on Telegram.
# Leave empty to use stdio port (no network needed, good for development).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Shell Configuration ───────────────────────────────────

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# Total conservation budget (energy units).
# Each operation costs energy. When budget is exhausted, operations fail.
# Default: 10000
HERMES_CONSERVATION_BUDGET=10000

# Background tick interval in milliseconds.
# Controls how often gravity decays, correlations are scanned, and deadbands checked.
# Default: 30000 (30 seconds)
HERMES_TICK_INTERVAL_MS=30000

# ── Paths ─────────────────────────────────────────────────
# Override these if your project layout differs.

# SQLite database path. Created if it doesn't exist.
# Default: universe.db
HERMES_DB_PATH=universe.db

# Directory containing room JSON configs.
# Each .json file defines a room (id, type, gravity, ensign, wiki, controls).
# Default: rooms/
HERMES_ROOMS_DIR=rooms

# Directory containing ensign JSON configs.
# Each .json file defines an ensign (id, model, provider, capabilities).
# Default: ensigns/
HERMES_ENSIGNS_DIR=ensigns
